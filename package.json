  "private": true,
  "description": "Run 《旅行青蛙·中国之旅》 offline (Egret H5) as a server-authoritative web app on a NAS, plus external push and AI-agent skills.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
