appname               = frog-nas
version               = 1.0.2
display_name          = 旅行青蛙
desc                  = 服务端权威的《旅行青蛙·中国之旅》离线版：引擎跑在 NAS 上，手机与电脑同看一个世界，关掉浏览器蛙也照常出门。支持 Webhook 与鸿蒙 MeoW 推送、给 AI Agent 用的 5 个 Skills。复用应用中心 Node.js v22 运行时，不需要 Docker。
platform              = all
source                = thirdparty
maintainer            = Balticx
distributor           = Kasbuky
distributor_url       = https://github.com/Kasbuky-sudo
desktop_uidir         = ui
desktop_applaunchname = frog-nas.Application
service_port          = 8980
ctl_stop              = true
checkport             = true
install_dep_apps      = nodejs_v22
changelog             = 修掉「加载到一半停住、进度条不动、NAS 不再传数据」的问题，三处一起改：服务端 keep-alive 从 Node 默认的 5 秒放宽到 65 秒——浏览器手里的复用连接被服务端悄悄关掉时，下一个请求会变成假死或连接重置；客户端为所有 XHR 补上 120 秒默认超时——引擎原本把超时设为 0（永不超时），一旦连接假死就会一直等下去，现在会在超时后自动重试（最多 3 次）；另外把「可疑请求」记进访问日志（响应被客户端掐断／4xx·5xx／耗时过长），可用 /api/logs/access 读取，正常请求不入账。
